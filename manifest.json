{
  "manifest_version": 3,
  "name": "Impulso",
  "version": "1.2",
  "description": "Local-first AI career copilot for resume analysis, application autofill, and job tracking.",
  "icons": {
    "16": "icons/impulso-16.png",
    "32": "icons/impulso-32.png",
    "48": "icons/impulso-48.png",
    "128": "icons/impulso-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open Impulso",
    "default_icon": {
      "16": "icons/impulso-16.png",
      "32": "icons/impulso-32.png",
      "48": "icons/impulso-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://jobs.ashbyhq.com/*",
        "*://*.ashbyhq.com/*"
      ],
      "js": [
        "autofill.js",
        "autofill/adapters/ashby.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://job-boards.greenhouse.io/*",
        "*://boards.greenhouse.io/*",
        "*://*.greenhouse.io/*"
      ],
      "js": [
        "autofill.js",
        "autofill/adapters/greenhouse.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://jobs.lever.co/*"
      ],
      "js": [
        "autofill.js",
        "autofill/adapters/lever.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.myworkdayjobs.com/*"
      ],
      "js": [
        "autofill.js",
        "autofill/adapters/workday.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://jobs.smartrecruiters.com/*"
      ],
      "js": [
        "autofill.js",
        "autofill/adapters/smartrecruiters.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
