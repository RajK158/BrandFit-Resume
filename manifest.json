{
  "manifest_version": 3,
  "name": "Impulso",
  "version": "1.2",
  "description": "Local-first AI career copilot for resume analysis, application autofill, and job tracking.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open Impulso"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://jobs.ashbyhq.com/*",
        "*://*.ashbyhq.com/*"
      ],
      "js": [
        "autofill.js",
        "autofill/adapters/ashby.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://job-boards.greenhouse.io/*",
        "*://boards.greenhouse.io/*",
        "*://*.greenhouse.io/*"
      ],
      "js": [
        "autofill.js",
        "autofill/adapters/greenhouse.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://jobs.lever.co/*"
      ],
      "js": [
        "autofill.js",
        "autofill/adapters/lever.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
